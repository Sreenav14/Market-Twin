APP_NAME=MarketTwin
APP_ENV=local
LOG_LEVEL=INFO

CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8000
WEB_HOST=localhost
WEB_PORT=5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=markettwin
POSTGRES_USER=markettwin
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://markettwin:change-me-locally@localhost:5432/markettwin

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=markettwin-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=marketTwin-local
AWS_SECRET_ACCESS_KEY=change-me-locally

COGNITO_ENABLED=false

MODEL_PROVIDER=openai
MODEL_NAME=openai/gpt-4o-mini
MODEL_API_KEY=

TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# LLM observability
# Disabled by default. Enable only when an OTLP backend is configured.
MARKETTWIN_OBSERVABILITY_ENABLED=false
# Whether to capture trace content.
MARKETTWIN_OBSERVABILITY_CAPTURE_CONTENT=false
# OpenTelemetry service identity.
OTEL_SERVICE_NAME=markettwin-local

# LangSmith OTLP trace endpoint.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces

# Example only. Put the real API key in .env, never commit it.
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<langsmith-api-key>,Langsmith-Project=markettwin-local